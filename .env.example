# 이 파일을 복사해서 ".env" 로 만들고 값을 채우세요.
#   (Windows PowerShell)  Copy-Item .env.example .env
# .env 는 절대 공유하지 마세요. 로그인 세션·키가 담깁니다.

# ── 네이버 로그인 쿠키 (README 의 '쿠키 얻는 법' 참고) ──
NID_AUT=여기에_NID_AUT_값_붙여넣기
NID_SES=여기에_NID_SES_값_붙여넣기

# ── 리버힐 카페 설정 ──
CAFE_CLUB_ID=31185658
CAFE_MENU_ID=0

# ── 나(사용자) 정보 ──
MY_NAME=김홍구
MY_PART=3

# ── 감지 설정 ──
KEYWORDS=배치표,추가,변동,휴무,취소,대기,스페어,3부,근무
NOTIFY_MODE=keyword
POLL_INTERVAL_MS=90000

# ── 서버 ──
PORT=3000
CONTACT_EMAIL=you@example.com

# ── 웹푸시 VAPID 키: `npm run gen-vapid` 실행하면 자동으로 아래에 추가됨 ──
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# ── 업적(성장 공간) ──
#  판정이 아직 여러 군데서 틀려 잠가뒀다. 기본값=잠김 — 켜는 쪽이 명시적이어야 한다.
#  잠긴 동안엔 판정·알림·화면이 전부 멈춘다('처음 열어본 날' 기록만 조용히 이어진다).
# TROPHY_ON=1

# ── 티스캐너(골프존) 두 번째 예약 소스 ──
#  카카오골프와 같은 사실을 다른 경로로 구해 서로 검산한다. ★로그인 필수(비회원 조회 불가).
#  비밀번호는 이 파일이 아니라 서버의 .env에만 둔다 — .env는 깃에 안 올라간다.
# TEESCANNER=1
# TEESCANNER_ID=골프존아이디
# TEESCANNER_PW=비밀번호
# TEESCANNER_CLUB=리버힐          # 검색어(한 번 찾으면 data/에 굳는다)
# TEESCANNER_CLUB_SEQ=            # 검색이 헷갈리면 여기에 번호를 직접 박는다
